# Contrato de backend (Supabase, InsForge u otro Postgres + Auth)
EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:54321
EXPO_PUBLIC_BACKEND_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Alias de Supabase (se usan si no defines BACKEND_*)
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Nunca pongas service_role ni secretos de servidor en la app móvil.
